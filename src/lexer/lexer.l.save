%{
#include <stdio.h>
%}

%%

"int"           { printf("KEYWORD: %s\n", yytext); }
"float"         { printf("KEYWORD: %s\n", yytext); }
"bool"          { printf("KEYWORD: %s\n", yytext); }
"if"            { printf("KEYWORD: %s\n", yytext); }
"else"          { printf("KEYWORD: %s\n", yytext); }
"while"         { printf("KEYWORD: %s\n", yytext); }
"print"         { printf("KEYWORD: %s\n", yytext); }
"true"          { printf("BOOLEAN: %s\n", yytext); }
"false"         { printf("BOOLEAN: %s\n", yytext); }

[0-9]+\.[0-9]+ { printf("FLOAT: %s\n", yytext); }
[0-9]+          { printf("INTEGER: %s\n", yytext); }

[a-zA-Z_][a-zA-Z0-9_]* { printf("IDENTIFIER: %s\n", yytext); }

"%{
#include <stdio.h>
%}

%%

"int"           { printf("KEYWORD: %s\n", yytext); }
"float"         { printf("KEYWORD: %s\n", yytext); }
"bool"          { printf("KEYWORD: %s\n", yytext); }
"if"            { printf("KEYWORD: %s\n", yytext); }
"else"          { printf("KEYWORD: %s\n", yytext); }
"while"         { printf("KEYWORD: %s\n", yytext); }
"print"         { printf("KEYWORD: %s\n", yytext); }
"true"          { printf("BOOLEAN: %s\n", yytext); }
"false"         { printf("BOOLEAN: %s\n", yytext); }

[0-9]+\.[0-9]+ { printf("FLOAT: %s\n", yytext); }
[0-9]+          { printf("INTEGER: %s\n", yytext); }

[a-zA-Z_][a-zA-Z0-9_]* { printf("IDENTIFIER: %s\n", yytext); }

"=="|"<="|">="|"!="|"<"|">"
                { printf("RELATIONAL_OP: %s\n", yytext); }

"&&"|"||"|"!"
                { printf("LOGICAL_OP: %s\n", yytext); }

"+"|"-"|"*"|"/"|"%"
                { printf("ARITHMETIC_OP: %s\n", yytext); }

"="             { printf("ASSIGN: %s\n", yytext); }

";"|"(" | ")" | "{" | "}"
                { printf("DELIMITER: %s\n", yytext); }

[ \t\n]+        ;

.               { printf("LEXICAL ERROR: %s\n", yytext); }

%%

int main() {
    yylex();
    return 0;
}=="|"<="|">="|"!="|"<"|">"
